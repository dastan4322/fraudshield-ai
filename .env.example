# Docker Compose requires a generated hexadecimal password. Do not commit .env.
POSTGRES_PASSWORD=
# Local Python development defaults to SQLite in /tmp when DATABASE_URL is absent.
# Production: postgresql+psycopg://user:password@hostname:5432/database
DATABASE_URL=
CORS_ORIGINS=http://localhost:3000
PUBLIC_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
API_URL=http://127.0.0.1:8000
# Optional administrator-owned trusted artifact. Never accept user-uploaded joblib files.
MODEL_ARTIFACT=
# Optional legacy administrator capability; accounts are recommended.
WORKSPACE_TOKEN=
# Password reset delivery is disabled until SMTP is configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
